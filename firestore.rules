rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User documents
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Default rule for user subcollections (tasks, habits, etc.)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Override for friends subcollection
      match /friends/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && 
                      request.auth.uid == friendId && 
                      (exists(/databases/$(database)/documents/users/$(userId)/friend_requests_sent/$(friendId)) ||
                       exists(/databases/$(database)/documents/users/$(friendId)/friend_requests_sent/$(userId)));
        // ALLOW FRIEND REMOVAL FROM BOTH ENDS:
        allow delete: if request.auth != null && request.auth.uid == friendId;
      }
      
      // Override for friend requests sent
      match /friend_requests_sent/{receiverId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == receiverId;
      }
      
      // Override for friend requests received
      match /friend_requests_received/{senderId} {
        // Owner of the user doc can fully manage their received requests
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // The sender can write a request document inside the receiver's subcollection
        allow create: if request.auth != null && 
                      request.auth.uid == senderId && 
                      request.resource.data.senderId == request.auth.uid &&
                      request.resource.data.receiverId == userId &&
                      request.resource.data.status == 'pending';
      }

      // Override for tasks subcollection
      match /tasks/{taskId} {
        allow read: if request.auth != null && 
          (request.auth.uid == userId || 
           (resource != null && request.auth.uid in resource.data.members) ||
           exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid)));
           
        allow write: if request.auth != null && 
          (request.auth.uid == userId || 
           (resource != null && request.auth.uid in resource.data.members) ||
           (request.auth.uid in request.resource.data.members && 
            exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid))));
      }
    }
    
    // Workspaces
    match /workspaces/{workspaceId} {
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow read, delete: if request.auth != null && 
        (request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.members);
      allow update: if request.auth != null && 
        (
          request.auth.uid == resource.data.ownerId || 
          request.auth.uid in resource.data.members ||
          (
            exists(/databases/$(database)/documents/project_invites/$(workspaceId + '_' + request.auth.uid)) &&
            get(/databases/$(database)/documents/project_invites/$(workspaceId + '_' + request.auth.uid)).data.status == 'pending'
          )
        );
    }
    
    // Projects subcollections (tasks, sprints, activity)
    match /projects/{projectId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid in get(/databases/$(database)/documents/workspaces/$(projectId)).data.members);
        
      match /workspace_chat/{messageId} {
        allow read: if request.auth != null && 
          (request.auth.uid in get(/databases/$(database)/documents/workspaces/$(projectId)).data.members);
          
        allow create: if request.auth != null && 
          (request.auth.uid in get(/databases/$(database)/documents/workspaces/$(projectId)).data.members) &&
          (request.resource.data.senderId == request.auth.uid || request.resource.data.type == 'system');
          
        allow update: if request.auth != null && 
          (request.auth.uid in get(/databases/$(database)/documents/workspaces/$(projectId)).data.members) &&
          resource.data.senderId == request.auth.uid &&
          resource.data.type != 'system';
          
        allow delete: if request.auth != null && 
          (request.auth.uid in get(/databases/$(database)/documents/workspaces/$(projectId)).data.members) &&
          resource.data.senderId == request.auth.uid &&
          resource.data.type != 'system';
      }

      match /{allSubpaths=**} {
        allow read, write: if request.auth != null && 
          (request.auth.uid in get(/databases/$(database)/documents/workspaces/$(projectId)).data.members);
      }
    }
    
    // Project Invites
    match /project_invites/{inviteId} {
      allow create: if request.auth != null && 
                    request.auth.uid == request.resource.data.senderId;
      allow read: if request.auth != null && 
                  (request.auth.uid == resource.data.senderId || 
                   request.auth.uid == resource.data.receiverId || 
                   (exists(/databases/$(database)/documents/workspaces/$(resource.data.projectId)) && 
                    request.auth.uid in get(/databases/$(database)/documents/workspaces/$(resource.data.projectId)).data.members));
      allow update, delete: if request.auth != null && 
                            (request.auth.uid == resource.data.senderId || 
                             request.auth.uid == resource.data.receiverId || 
                             (exists(/databases/$(database)/documents/workspaces/$(resource.data.projectId)) && 
                              request.auth.uid == get(/databases/$(database)/documents/workspaces/$(resource.data.projectId)).data.ownerId));
    }
    
    // Focus Sessions
    match /focus_sessions/{sessionId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Focus Stats
    match /user_focus_stats/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.receiverId;
    }
    
    // Task Invites
    match /task_invites/{inviteId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUserId;
      allow read, update, delete: if request.auth != null && 
        (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);
    }
  }
}
